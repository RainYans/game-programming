--- !u!114 &586193499
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 586193498}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2a9acf652793521458d01c45cf1a625d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  pages:
  - illustration: {fileID: 21300000, guid: 76503e73e032f5449836e03a4fc31797, type: 3}
    text: The wild monsters came, and the villages fell silent behind locked gates.
  - illustration: {fileID: 21300000, guid: e201f0600d37008478d2dca93591668a, type: 3}
    text: But you saw what others feared - that a monster, raised with care, can
      become a friend.
  - illustration: {fileID: 21300000, guid: 6d4489ae9881f294f832a872075c796c, type: 3}
    text: On your little farm, you plant them, feed them, and watch them grow strong.
  - illustration: {fileID: 21300000, guid: a9ceb1815b341a244a82c128fc5f8831, type: 3}
    text: Then you lead your squad out - to take back the land, one village at a
      time.
  - illustration: {fileID: 21300000, guid: e8d960310f8c1044eb129c4d585a00ad, type: 3}
    text: 'Your story begins now.


      Welcome to Monster Farm.'
  illustration: {fileID: 501509179}
  narration: {fileID: 904336805}
  pageLabel: {fileID: 773224554}
  contentRoot: {fileID: 721954157}
